# Autonomous Engineering Agent Configuration

# LLM Provider Configuration ("mock", "gemini", "openai", "anthropic")
LLM_PROVIDER=mock
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-pro

# GitHub Integration
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database & Cache (default SQLite for effortless zero-config local run)
DATABASE_URL=sqlite:///./agent.db
REDIS_URL=redis://localhost:6379

# Execution & Sandbox Limits
MAX_AGENT_ITERATIONS=5
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY_LIMIT=1g
REQUIRE_HUMAN_APPROVAL_FOR_PR=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
